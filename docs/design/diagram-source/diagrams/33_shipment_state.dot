digraph G {
      graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.22", ranksep="0.48", splines=spline, fontname="Noto Sans CJK SC", labelloc="t"];
      node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10.5, color="#D6DCE4", fillcolor="white", fontcolor="#1F2937", margin="0.12,0.08"];
      edge [fontname="Noto Sans CJK SC", fontsize=8.5, color="#6B7280", fontcolor="#374151", arrowsize=0.7];
graph [label="TMS 运输单状态机", fontsize=15];
Open [label="已创建", fillcolor="#EAF2FF"];
Planned [label="已计划", fillcolor="white"];
Approved [label="已审批", fillcolor="white"];
Tendered [label="已委托", fillcolor="white"];
Accepted [label="已接单", fillcolor="white"];
Dispatched [label="已派车", fillcolor="white"];
Tracking [label="运输中", fillcolor="white"];
Arrived [label="已到达", fillcolor="white"];
Delivered [label="已签收", fillcolor="white"];
POD [label="回单确认", fillcolor="white"];
Settled [label="已结算", fillcolor="#E8F5E9"];
Closed [label="已关闭", fillcolor="#E8F5E9"];
Rejected [label="已拒绝", fillcolor="#FDECEC"];
Cancelled [label="已取消", fillcolor="#FDECEC"];
Open -> Planned [label="计划"];
Planned -> Approved [label="审批"];
Approved -> Tendered [label="委托"];
Tendered -> Accepted [label="接受"];
Tendered -> Rejected [label="拒绝/超时"];
Rejected -> Planned [label="改派"];
Accepted -> Dispatched [label="派车"];
Dispatched -> Tracking [label="发运"];
Tracking -> Arrived [label="到达"];
Arrived -> Delivered [label="签收"];
Delivered -> POD [label="回单审核"];
POD -> Settled [label="结算"];
Settled -> Closed [label="归档"];
Open -> Cancelled [label="取消"];
}