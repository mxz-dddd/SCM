digraph G {
      graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.3", ranksep="0.48", splines=spline, fontname="Noto Sans CJK SC", labelloc="t"];
      node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10.5, color="#D6DCE4", fillcolor="white", fontcolor="#1F2937", margin="0.12,0.08"];
      edge [fontname="Noto Sans CJK SC", fontsize=8.5, color="#6B7280", fontcolor="#374151", arrowsize=0.7];
graph [label="退货与逆向物流", fontsize=15];
s [label="客户退货/RMA申请", shape=oval, fillcolor="#EAF2FF", color="#2A6FDB"];
au [label="规则校验与退货授权", shape=diamond, fillcolor="#FFF4D6", color="#C58B00"];
tr [label="预约或逆向运输", fillcolor="#FFFFFF"];
rec [label="退货收货与识别", fillcolor="#FFFFFF"];
qc [label="质检与处置判定", shape=diamond, fillcolor="#FFF4D6", color="#C58B00"];
disp [label="上架/维修/报废/退供应商", fillcolor="#FFFFFF"];
fin [label="退款、换货与费用结算", fillcolor="#FFFFFF"];
e [label="RMA 关闭", shape=oval, fillcolor="#E8F5E9", color="#087F8C"];
x [label="无授权、超期、货不符", fillcolor="#FDECEC", color="#B42318"];
s -> au;
au -> tr [label="通过"];
au -> x [label="拒绝"];
tr -> rec;
rec -> qc;
qc -> disp;
qc -> x [label="异常"];
disp -> fin;
fin -> e;
}