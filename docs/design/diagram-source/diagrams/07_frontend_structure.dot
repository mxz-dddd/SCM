digraph G {
      graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.25", ranksep="0.42", splines=spline, fontname="Noto Sans CJK SC", labelloc="t"];
      node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10.5, color="#D6DCE4", fillcolor="white", fontcolor="#1F2937", margin="0.12,0.08"];
      edge [fontname="Noto Sans CJK SC", fontsize=8.5, color="#6B7280", fontcolor="#374151", arrowsize=0.7];

      shell [label="Application Shell\n左侧模块导航 · 顶部上下文 · 多标签工作区", fillcolor="#16324F", fontcolor="white", color="#16324F"];
      list [label="列表查询页\nQueryPanel + CommandBar + DataGrid + SavedView", fillcolor="#EAF2FF"];
      detail [label="主从详情页\n摘要 / 状态阶梯 / 子表 / 时间线 / 附件", fillcolor="#E8F5E9"];
      task [label="任务工作台\n队列 / 领取 / 扫描 / 异常 / 绩效", fillcolor="#FFF4D6"];
      board [label="地图与看板\nKPI / 轨迹 / 热力 / 告警 / 下钻", fillcolor="#E8EDFF"];
      drawer [label="统一交互原语\nDrawer / Modal / ContextMenu / Toast / Print / Export"];
      shell -> list; shell -> detail; shell -> task; shell -> board;
      list -> drawer; detail -> drawer; task -> drawer; board -> drawer;
    }