  attributesHash    String             @map("attributes_hash") @db.Char(64)
  correlationId     String             @map("correlation_id") @db.VarChar(100)
  permissionVersion Int                @map("permission_version")

  @@index([tenantId, accountId, createdAt], map: "data_policy_decision_tenant_account_created_idx")
