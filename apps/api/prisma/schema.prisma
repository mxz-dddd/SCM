  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)

  @@unique([tenantId, productId, code, versionNumber], map: "package_spec_tenant_product_code_version_key")
  @@index([tenantId, productId, status, level], map: "package_spec_tenant_product_status_level_idx")
  @@index([tenantId, customerId, status], map: "package_spec_tenant_customer_status_idx")
  @@map("package_spec")
