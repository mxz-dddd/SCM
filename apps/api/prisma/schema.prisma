  versionNumber     Int               @map("version_number")
  level             PackageLevel
  customerId        String?           @map("customer_id") @db.Uuid
  parentSpecId      String?           @map("parent_spec_id") @db.Uuid
  originalUom       String            @map("original_uom") @db.VarChar(20)
  baseUom           String            @map("base_uom") @db.VarChar(20)
  quantityInBase    Decimal           @map("quantity_in_base") @db.Decimal(24, 12)
  netWeight         Decimal?          @map("net_weight") @db.Decimal(24, 12)
  grossWeight       Decimal?          @map("gross_weight") @db.Decimal(24, 12)
  weightUom         String?           @map("weight_uom") @db.VarChar(20)
  length            Decimal?          @db.Decimal(24, 12)
