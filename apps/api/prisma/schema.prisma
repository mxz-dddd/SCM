/// Executable reference model for the mandatory persistence conventions.
/// Domain cards replace this fixture with their owned aggregates while retaining
/// these fields, tenant-first indexes and value-object storage rules.
model DataBaseline {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy              String         @map("created_by") @db.Uuid
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy              String         @map("updated_by") @db.Uuid
  version                Int            @default(1)
  status                 BaselineStatus @default(ACTIVE)
  amount                 Decimal        @db.Decimal(20, 6)
  currency               String         @db.Char(3)
  quantityOriginal       Decimal        @map("quantity_original") @db.Decimal(20, 6)
  originalUom            String         @map("original_uom") @db.VarChar(16)
  quantityBase           Decimal        @map("quantity_base") @db.Decimal(20, 6)
  baseUom                String         @map("base_uom") @db.VarChar(16)
  packageSpecVersionId   String         @map("package_spec_version_id") @db.Uuid
  extensionSchemaId      String         @map("extension_schema_id") @db.VarChar(100)
  extensionSchemaVersion Int            @map("extension_schema_version")
  extensionFields        Json           @default("{}") @map("extension_fields") @db.JsonB

  @@index([tenantId, status], map: "data_baseline_tenant_status_idx")
  @@map("data_baseline")
  @@schema("platform")
}

model ProductCategory {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String                @map("created_by") @db.Uuid
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String                @map("updated_by") @db.Uuid
  version   Int                   @default(1)
  status    ProductCategoryStatus @default(ACTIVE)
  code      String                @db.VarChar(100)
  name      String                @db.VarChar(200)
  parentId  String?               @map("parent_id") @db.Uuid
  path      String                @db.VarChar(1000)

  @@unique([tenantId, code], map: "product_category_tenant_code_key")
  @@index([tenantId, parentId, status], map: "product_category_tenant_parent_idx")
  @@map("product_category")
  @@schema("mdm")
}

model Product {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String          @map("created_by") @db.Uuid
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String          @map("updated_by") @db.Uuid
  version               Int             @default(1)
  status                ProductStatus   @default(DRAFT)
  sku                   String          @db.VarChar(100)
  name                  String          @db.VarChar(300)
  categoryId            String?         @map("category_id") @db.Uuid
  categorySnapshot      Json            @default("{}") @map("category_snapshot") @db.JsonB
  baseUom               String          @map("base_uom") @db.VarChar(20)
  temperatureZone       TemperatureZone @default(AMBIENT) @map("temperature_zone")
  hazardous             Boolean         @default(false)
  hazardousAttributes   Json            @default("{}") @map("hazardous_attributes") @db.JsonB
  batchControl          BatchControl    @default(NONE) @map("batch_control")
  serialControl         SerialControl   @default(NONE) @map("serial_control")
  shelfLifeDays         Int?            @map("shelf_life_days")
  minimumRemainingDays  Int?            @map("minimum_remaining_days")
  currentVersionNumber  Int             @default(0) @map("current_version_number")

  @@unique([tenantId, sku], map: "product_tenant_sku_key")
  @@index([tenantId, status, categoryId, sku], map: "product_tenant_status_category_sku_idx")
  @@map("product")
  @@schema("mdm")
}

model ProductVersion {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String               @map("created_by") @db.Uuid
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy     String               @map("updated_by") @db.Uuid
  version       Int                  @default(1)
  status        ProductVersionStatus @default(PUBLISHED)
  productId     String               @map("product_id") @db.Uuid
  sku           String               @db.VarChar(100)
  versionNumber Int                  @map("version_number")
  snapshot      Json                 @db.JsonB
  publishedAt   DateTime             @default(now()) @map("published_at") @db.Timestamptz(3)

  @@unique([tenantId, productId, versionNumber], map: "product_version_tenant_product_version_key")
  @@index([tenantId, sku, versionNumber], map: "product_version_tenant_sku_version_idx")
  @@map("product_version")
  @@schema("mdm")
}

