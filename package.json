{
  "name": "scm-cloud",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @scm/api db:generate",
    "db:migrate": "pnpm --filter @scm/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @scm/api db:migrate:deploy",
    "db:seed": "pnpm --filter @scm/api db:seed",
    "dev": "turbo run dev --parallel",
    "event:catalog": "pnpm --filter @scm/api exec tsx ../../scripts/generate-v2-event-catalog.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "migration:safety": "node scripts/check-migration-safety.mjs",
    "postinstall": "pnpm db:generate",
    "test": "turbo run test",
    "test:e2e": "node scripts/run-p2-e2e.mjs",
    "test:p3-e2e": "node scripts/run-p3-e2e.mjs",
    "test:p4-e2e": "node scripts/run-p4-e2e.mjs",
    "test:p5-readiness": "node scripts/run-p5-readiness.mjs",
    "test:v2-e2e": "node scripts/run-v2-e2e.mjs",
    "test:ui-reference": "node scripts/ui-reference/validate-reference-catalog.mjs && pnpm --filter @scm/web exec vitest run src/router/route-registry.test.tsx",
    "test:visual": "playwright test --config=playwright.ui-parity.config.ts",
    "test:ui-parity": "pnpm test:ui-reference && node scripts/ui-reference/validate-layout-comparison.mjs && pnpm test:visual",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
